{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ad_sharedcommondataserviceforapps_03920"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "t-05-sanctions-assessment-update-trigger"
          },
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "assessmentId": {
                  "title": "Assessment ID",
                  "type": "string",
                  "description": "The GUID of the ad_Assessment record to update."
                },
                "matchId": {
                  "title": "Match ID",
                  "type": "string",
                  "description": "The GUID of the originating ad_Match record (for audit logging)."
                },
                "agentSummary": {
                  "title": "Agent Summary",
                  "type": "string",
                  "description": "The structured violation summary or no-match statement produced by the Sanctions Regime Check Agent."
                },
                "matchFound": {
                  "title": "Match Found",
                  "type": "boolean",
                  "description": "True if the agent found at least one keyword match; false for a no-match outcome."
                }
              },
              "required": ["assessmentId", "matchId", "agentSummary", "matchFound"]
            }
          }
        }
      },
      "actions": {
        "Scope_Try": {
          "type": "Scope",
          "actions": {
            "Get_Assessment": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ad_assessments",
                  "recordId": "@triggerBody()?['assessmentId']",
                  "$select": "ad_assessmentid,ad_comments,ad_result"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Compose_Appended_Comment": {
              "type": "Compose",
              "inputs": "@concat(\n  coalesce(outputs('Get_Assessment')?['body/ad_comments'], ''),\n  if(empty(coalesce(outputs('Get_Assessment')?['body/ad_comments'], '')), '', '\n\n'),\n  '--- Sanctions Regime Check Agent [', utcNow('yyyy-MM-ddTHH:mm:ssZ'), '] | Match ID: ', triggerBody()?['matchId'], ' ---\n',\n  triggerBody()?['agentSummary']\n)",
              "runAfter": {
                "Get_Assessment": ["Succeeded"]
              }
            },
            "Update_Assessment_Comments": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ad_assessments",
                  "recordId": "@triggerBody()?['assessmentId']",
                  "item/ad_comments": "@outputs('Compose_Appended_Comment')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Compose_Appended_Comment": ["Succeeded"]
              }
            },
            "Condition_Match_Found_And_Not_Already_True_Hit": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": ["@triggerBody()?['matchFound']", true]
                  },
                  {
                    "not": {
                      "equals": [
                        "@outputs('Get_Assessment')?['body/ad_result']",
                        120830002
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Update_Assessment_Result_True_Hit": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ad_assessments",
                      "recordId": "@triggerBody()?['assessmentId']",
                      "item/ad_result": 120830002
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Update_Assessment_Comments": ["Succeeded"]
              }
            },
            "Response_Success": {
              "type": "Response",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "status": "success",
                  "assessmentId": "@triggerBody()?['assessmentId']",
                  "matchId": "@triggerBody()?['matchId']",
                  "resultUpdated": "@triggerBody()?['matchFound']",
                  "timestamp": "@utcNow()"
                }
              },
              "runAfter": {
                "Condition_Match_Found_And_Not_Already_True_Hit": ["Succeeded"]
              }
            }
          },
          "runAfter": {}
        },
        "Scope_Catch": {
          "type": "Scope",
          "actions": {
            "Compose_Error_Details": {
              "type": "Compose",
              "inputs": {
                "flowName": "Dataverse - Update ad_Assessment: Sanctions Regime Check",
                "assessmentId": "@triggerBody()?['assessmentId']",
                "matchId": "@triggerBody()?['matchId']",
                "errorMessage": "@{result('Scope_Try')?[0]?['error']?['message']}",
                "failedAction": "@{result('Scope_Try')?[0]?['name']}",
                "timestamp": "@utcNow()"
              }
            },
            "Send_Error_Notification": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('adesso_SanctionsNotificationRecipient')",
                  "emailMessage/Subject": "@concat('[SANCTIONS AGENT ERROR] Assessment update failed | Match ID: ', triggerBody()?['matchId'])",
                  "emailMessage/Body": "@concat('<p>The Sanctions Regime Check Agent failed to update an assessment record.</p><p><strong>Match ID:</strong> ', triggerBody()?['matchId'], '</p><p><strong>Assessment ID:</strong> ', triggerBody()?['assessmentId'], '</p><p><strong>Error:</strong> ', result('Scope_Try')?[0]?['error']?['message'], '</p><p><strong>Timestamp:</strong> ', utcNow(), '</p>')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Compose_Error_Details": ["Succeeded"]
              }
            },
            "Response_Failure": {
              "type": "Response",
              "inputs": {
                "statusCode": 500,
                "body": {
                  "status": "error",
                  "assessmentId": "@triggerBody()?['assessmentId']",
                  "matchId": "@triggerBody()?['matchId']",
                  "errorMessage": "@{result('Scope_Try')?[0]?['error']?['message']}",
                  "timestamp": "@utcNow()"
                }
              },
              "runAfter": {
                "Send_Error_Notification": ["Succeeded", "Failed"]
              }
            },
            "Terminate_Failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ASSESSMENT_UPDATE_ERROR",
                  "message": "@concat('Assessment ID: ', triggerBody()?['assessmentId'], ' | Match ID: ', triggerBody()?['matchId'], ' | Error: ', result('Scope_Try')?[0]?['error']?['message'])"
                }
              },
              "runAfter": {
                "Response_Failure": ["Succeeded"]
              }
            }
          },
          "runAfter": {
            "Scope_Try": ["Failed", "TimedOut", "Skipped"]
          }
        }
      }
    }
  }
}
