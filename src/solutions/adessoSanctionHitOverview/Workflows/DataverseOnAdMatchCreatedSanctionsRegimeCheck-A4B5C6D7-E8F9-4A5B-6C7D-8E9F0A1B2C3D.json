{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ad_sharedcommondataserviceforapps_03920"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added_(ad_Match)": {
          "metadata": {
            "operationMetadataId": "t-01-sanctions-regime-check-trigger"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "ad_match",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "",
              "subscriptionRequest/filteringattributes": ""
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Scope_Try": {
          "type": "Scope",
          "actions": {
            "Condition_TransactionMatch_Not_Null": {
              "type": "If",
              "expression": {
                "not": {
                  "equals": [
                    "@triggerBody()?['_ad_transactionmatch_value']",
                    null
                  ]
                }
              },
              "actions": {
                "Get_SanctionTransaction": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ad_sanctiontransactions",
                      "recordId": "@triggerBody()?['_ad_transactionmatch_value']",
                      "$select": "ad_transactionmessage,ad_creditorname,ad_creditoraddress,ad_debtorname,ad_debtoradress,ad_redirection"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Compose_Corpus": {
                  "type": "Compose",
                  "inputs": "@concat(\n  coalesce(triggerBody()?['ad_name'], ''), ' ',\n  coalesce(triggerBody()?['ad_nameonlist'], ''), ' ',\n  coalesce(triggerBody()?['ad_matchonlist'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_transactionmessage'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_creditorname'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_creditoraddress'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_debtorname'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_debtoradress'], ''), ' ',\n  coalesce(outputs('Get_SanctionTransaction')?['body/ad_redirection'], '')\n)",
                  "runAfter": {
                    "Get_SanctionTransaction": ["Succeeded"]
                  }
                },
                "Get_SanctionAlert_From_Match": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ad_matches",
                      "recordId": "@triggerBody()?['ad_matchid']",
                      "$select": "_ad_sanctionalert_value"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Compose_Corpus": ["Succeeded"]
                  }
                },
                "Run_Sanctions_Regime_Check_Agent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_microsoftcopilotstudio",
                      "operationId": "RunCopilot",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio"
                    },
                    "parameters": {
                      "bot": "@parameters('adesso_SanctionsRegimeAgentName')",
                      "question": "@concat('MATCH_ID:', triggerBody()?['ad_matchid'], '|SANCTION_ALERT_ID:', outputs('Get_SanctionAlert_From_Match')?['body/_ad_sanctionalert_value'], '|CORPUS:', outputs('Compose_Corpus'))"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Get_SanctionAlert_From_Match": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate_No_Transaction_Succeeded": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded",
                      "runError": {
                        "code": "WARNING",
                        "message": "@concat('Sanctions Regime Check: ad_Match ', triggerBody()?['ad_matchid'], ' has no related ad_SanctionTransaction. Processing skipped.')"
                      }
                    }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {}
        },
        "Scope_Catch": {
          "type": "Scope",
          "actions": {
            "Compose_Error_Details": {
              "type": "Compose",
              "inputs": {
                "flowName": "Dataverse - On ad_Match Created: Sanctions Regime Check",
                "matchId": "@triggerBody()?['ad_matchid']",
                "errorMessage": "@{result('Scope_Try')?[0]?['error']?['message']}",
                "failedAction": "@{result('Scope_Try')?[0]?['name']}",
                "timestamp": "@utcNow()"
              }
            },
            "Send_Error_Notification": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('adesso_SanctionsNotificationRecipient')",
                  "emailMessage/Subject": "@concat('[SANCTIONS AGENT ERROR] Match ID: ', triggerBody()?['ad_matchid'])",
                  "emailMessage/Body": "@concat('<p>The Sanctions Regime Check Agent failed to process a sanctions match.</p><p><strong>Match ID:</strong> ', triggerBody()?['ad_matchid'], '</p><p><strong>Error:</strong> ', result('Scope_Try')?[0]?['error']?['message'], '</p><p><strong>Timestamp:</strong> ', utcNow(), '</p>')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Compose_Error_Details": ["Succeeded"]
              }
            },
            "Terminate_Failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "SANCTIONS_AGENT_ERROR",
                  "message": "@concat('Match ID: ', triggerBody()?['ad_matchid'], ' | Error: ', result('Scope_Try')?[0]?['error']?['message'])"
                }
              },
              "runAfter": {
                "Send_Error_Notification": ["Succeeded", "Failed"]
              }
            }
          },
          "runAfter": {
            "Scope_Try": ["Failed", "TimedOut", "Skipped"]
          }
        }
      }
    }
  }
}
