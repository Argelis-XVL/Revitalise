async function requestAssessment(executionContext) {

    // 1. Get the global user context
    const globalContext = Xrm.Utility.getGlobalContext();
    const currentUserId = globalContext.userSettings.userId.replace(/[{}]/g, "");
    const currentUserName = globalContext.userSettings.userName;

    // 2. Confirm dialog 
    const confirmResult = await Xrm.Navigation.openConfirmDialog(
        {
            text: "Are you sure you want to request an assessment by a senior analyst?",
            title: "Confirm the request for assessment",
            subtitle: "Do you want to request an assessment?"
        },
        {
            confirmButtonLabel: "Yes",
            cancelButtonLabel: "No"
        }
    );

    if (!confirmResult.confirmed) {
        return; // User cancelled
    }

    // 3. Get current record from form or grid
    const formContext = executionContext;
    let recordId = formContext.data.entity.getId().replace(/[{}]/g, "");

    // 4. Prepare update payload
    const updateData = {
        // Set Status (replace schema name with the real logical name you mentioned)
        "ad_status": 120830003, // "Sent for Assessment" OPTIONSET VALUE (replace with correct numeric value!)

        // Set assessment requested by = current user lookup
        "ad_AssessmentRequestedBy@odata.bind": "/systemusers(" + currentUserId + ")",

        // Set assessment requested on = now
        "ad_assessmentrequestedon": new Date().toISOString()
    };

    // 5. Update the record using Web API
    await Xrm.WebApi.updateRecord("ad_sanctionalert", recordId, updateData);

    // 6. Refresh form
    // Refresh data but keep the user on the same tab
    formContext.data.refresh(false);

    // No navigation — keeping the current tab open
}