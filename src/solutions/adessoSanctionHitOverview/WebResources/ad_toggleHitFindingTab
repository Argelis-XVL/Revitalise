function toggleHitFindingTab(executionContext) {
    const formContext = executionContext.getFormContext();

    // ---- CONFIGURATION ----
    const tabName = "hitfinding";               // Name of the tab on the form
    const fieldName = "ad_alerttype";           // Internal name of the choice field
    const visibleValue = "Hit Finding";         // The display text of the choice
    // ------------------------

    // Get the label of the selected option
    const selectedOption = formContext.getAttribute(fieldName).getSelectedOption();
    const selectedLabel = selectedOption ? selectedOption.text : null;

    // Show tab if "Hit Finding" is selected; otherwise hide
    const shouldShow = selectedLabel === visibleValue;

    formContext.ui.tabs.get(tabName).setVisible(shouldShow);
}