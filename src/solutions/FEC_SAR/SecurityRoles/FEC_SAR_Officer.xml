<?xml version="1.0" encoding="utf-8"?>
<Role>
  <name>FEC SAR Officer</name>
  <RoleTemplate schemaName="fec_SAROfficer" />
  <IsCustomizable>1</IsCustomizable>
  <description>SAR Officer role. Privileges: Alert R, Case R, SAR R/W via FEC_SAR_Restricted CSP, Party R. Cannot hold FEC AML Analyst simultaneously (FEC-007).</description>
  <privileges>
    <privilege name="prvReadfec_alert" level="3" />
    <privilege name="prvReadfec_case" level="3" />
    <privilege name="prvReadfec_sar" level="3" />
    <privilege name="prvWritefec_sar" level="3" />
    <privilege name="prvAppendTofec_sar" level="3" />
    <privilege name="prvReadfec_party" level="3" />
    <!-- SAR columns require FEC_SAR_Restricted CSP grant in addition to this role -->
  </privileges>
</Role>
