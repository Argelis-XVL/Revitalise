<?xml version="1.0" encoding="utf-8"?>
<Role>
  <name>FEC AML Analyst</name>
  <RoleTemplate schemaName="fec_AMLAnalyst" />
  <IsCustomizable>1</IsCustomizable>
  <description>AML Analyst role. Privileges: Alert R/W/C, Case R/W/C, Party R. No SAR table access (zero privileges on fec_sar — tipping-off prevention FEC-001). Cannot hold FEC SAR Officer simultaneously (FEC-007).</description>
  <privileges>
    <privilege name="prvCreatefec_alert" level="3" />
    <privilege name="prvReadfec_alert" level="3" />
    <privilege name="prvWritefec_alert" level="3" />
    <privilege name="prvAppendTofec_alert" level="3" />
    <privilege name="prvAppendFec_alert" level="3" />
    <privilege name="prvCreatefec_case" level="3" />
    <privilege name="prvReadfec_case" level="3" />
    <privilege name="prvWritefec_case" level="3" />
    <privilege name="prvAppendTofec_case" level="3" />
    <privilege name="prvAppendFec_case" level="3" />
    <privilege name="prvCreatefec_casealert" level="3" />
    <privilege name="prvReadfec_casealert" level="3" />
    <privilege name="prvWritefec_casealert" level="3" />
    <privilege name="prvReadfec_party" level="3" />
    <!-- fec_sar: NO privileges (tipping-off prevention) -->
    <!-- fec_notificationlog: no access -->
  </privileges>
</Role>
