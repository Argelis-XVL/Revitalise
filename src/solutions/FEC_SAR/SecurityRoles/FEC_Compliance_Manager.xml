<?xml version="1.0" encoding="utf-8"?>
<Role>
  <name>FEC Compliance Manager</name>
  <RoleTemplate schemaName="fec_ComplianceManager" />
  <IsCustomizable>1</IsCustomizable>
  <description>Compliance Manager role. Privileges: Alert R/W, Case R/W/Approve, SAR R/W/Approve via FEC_SAR_Restricted CSP, Party R/W, Audit R. Receives approval requests from Flows 3 and 4.</description>
  <privileges>
    <privilege name="prvCreatefec_alert" level="3" />
    <privilege name="prvReadfec_alert" level="3" />
    <privilege name="prvWritefec_alert" level="3" />
    <privilege name="prvAppendTofec_alert" level="3" />
    <privilege name="prvCreatefec_case" level="3" />
    <privilege name="prvReadfec_case" level="3" />
    <privilege name="prvWritefec_case" level="3" />
    <privilege name="prvAppendTofec_case" level="3" />
    <privilege name="prvReadfec_sar" level="3" />
    <privilege name="prvWritefec_sar" level="3" />
    <privilege name="prvAppendTofec_sar" level="3" />
    <privilege name="prvCreatefec_party" level="3" />
    <privilege name="prvReadfec_party" level="3" />
    <privilege name="prvWritefec_party" level="3" />
    <privilege name="prvReadfec_notificationlog" level="3" />
  </privileges>
</Role>
