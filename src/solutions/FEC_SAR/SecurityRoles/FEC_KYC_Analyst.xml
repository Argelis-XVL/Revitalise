<?xml version="1.0" encoding="utf-8"?>
<Role>
  <name>FEC KYC Analyst</name>
  <RoleTemplate schemaName="fec_KYCAnalyst" />
  <IsCustomizable>1</IsCustomizable>
  <description>KYC Analyst role. Privileges: Party R/W. PII columns (fec_nationalid, fec_dateofbirth, fec_address) accessible via FEC_PII_Confidential CSP grant. No SAR access.</description>
  <privileges>
    <privilege name="prvCreatefec_party" level="3" />
    <privilege name="prvReadfec_party" level="3" />
    <privilege name="prvWritefec_party" level="3" />
    <privilege name="prvAppendTofec_party" level="3" />
    <!-- PII columns require FEC_PII_Confidential CSP grant in addition to this role -->
    <!-- No fec_sar access -->
  </privileges>
</Role>
