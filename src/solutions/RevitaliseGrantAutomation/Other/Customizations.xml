rrect spelling, do not add\npunctuation, and do not change any label in square brackets except as the name rules say.\n\nReply with the rewritten text only, with no explanation, quotation marks or code fences.\n"}],"definitions":{"inputs":[{"id":"Narrative","text":"Narrative","type":"text"},{"id":"NeutralTerms","text":"NeutralTerms","type":"text"},{"id":"Titles","text":"Titles","type":"text"},{"id":"NameRules","text":"NameRules","type":"text"},{"id":"Labels","text":"Labels","type":"text"}],"formulas":[],"data":[],"output":{"formats":["text"]}},"modelParameters":{"modelType":"gpt-41-mini","gptParameters":{"temperature":0}},"settings":{"recordRetrievalLimit":30,"shouldPreserveRecordLinks":null,"runtime":null,"contentModerationLevel":"Low"},"code":"","signature":""}</msdyn_customconfiguration>
