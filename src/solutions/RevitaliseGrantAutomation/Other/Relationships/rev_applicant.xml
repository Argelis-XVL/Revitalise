<?xml version="1.0" encoding="utf-8"?>
<!--
  Relationships whose REFERENCED (one-side) table is rev_applicant.

  One relationship in Phase 1: Applicant (1) -> Application (N). A second added WBS 0.4
  remainder: Applicant (1) -> Bank Account (N), parental - the TAD section 3.4 Gap 2 DERIVED
  remediation for a table no source document gave a retention rule at all (see
  Entities/rev_bankaccount/Entity.xml's own header for the full story). Both children are
  grouped into this one file because both are referenced-side rev_applicant, matching how
  rev_application.xml groups rev_grant and rev_review beside it.

  THE FILE NAME IS NOT A FREE CHOICE. EntityRelationshipProcessor groups a OneToMany
  relationship into the file named after its <ReferencedEntityName>, not its referencing
  table (GetEntityRelationshipFileName), and it reads every *.xml in this folder into a
  dictionary keyed by @Name. Naming this file rev_application.xml would survive a pack today
  but would collide with the rev_applicant.xml a later `pac solution unpack` writes, and two
  files declaring the same @Name is a hard DuplicatedRelationshipName error. Each detail file
  keeps the <EntityRelationships> wrapper: unlike OptionSets/*.xml, this processor reads
  CHILDREN named EntityRelationship out of the file root rather than treating the root itself
  as the component. The matching stub in Other/Relationships.xml must stay childless.

  This is a PARENTAL relationship, and that is load-bearing rather than incidental.
  The retention design (TAD ADR-004, section 3.3) deletes ONE parent row and requires the
  whole case to follow, so every cascade behaviour below is set to Cascade. TAD section 3.3
  records the deliberate deviation from knowledge/technology/dataverse.md, which would
  otherwise prescribe Restrict Delete for a table with a regulatory retention period: here
  the regulatory obligation is to DELETE at the end of the period, not to preserve, so
  Restrict Delete would block the retention design outright.

  The guardrails against accidental deletion are recorded in TAD section 3.3 and are not
  in this file: the bulk-delete jobs query on status AND date and never run unfiltered,
  Purview basic labels are a time-based backstop, and no Phase 1 role holds a Delete
  privilege on rev_application except REV Admin.
-->
<EntityRelationships>
  <EntityRelationship Name="rev_applicant_rev_application_applicantid">
    <EntityRelationshipType>OneToMany</EntityRelationshipType>
    <IsCustomizable>1</IsCustomizable>
    <IntroducedVersion>1.0.0.0</IntroducedVersion>
    <IsHierarchical>0</IsHierarchical>
    <ReferencingEntityName>rev_application</ReferencingEntityName>
    <ReferencedEntityName>rev_applicant</ReferencedEntityName>
    <ReferencingAttributeName>rev_applicantid</ReferencingAttributeName>
    <RelationshipDescription>
      <Descriptions>
        <Description description="The applicant this application was submitted by or on behalf of. Parental: deleting the applicant deletes every application they hold, which is what makes both the retention schedule (FR-048) and an erasure request (FR-051) reach the whole case from a single reference." languagecode="1033" />
      </Descriptions>
    </RelationshipDescription>
    <!-- Parental cascade profile. All five behaviours Cascade; rollup views do not apply. -->
    <CascadeAssign>Cascade</CascadeAssign>
    <CascadeDelete>Cascade</CascadeDelete>
    <CascadeReparent>Cascade</CascadeReparent>
    <CascadeShare>Cascade</CascadeShare>
    <CascadeUnshare>Cascade</CascadeUnshare>
    <CascadeRollupView>NoCascade</CascadeRollupView>
    <IsValidForAdvancedFind>1</IsValidForAdvancedFind>
    <!-- RelationshipRoleType FIXED 2026-08-14 — confirmed via the real XSD (fetched this
         session) that the values are 0 (Referencing Entity, the "many" side — rev_application)
         and 1 (Referenced Entity, the "one" side — rev_applicant), not the 1/2 this file used
         to declare. Live against DEV, that wrong pair produced "0 relationship roles for the
         referencing entity were found" — Dataverse was correctly reporting that nothing in
         this file had RelationshipRoleType=0, because nothing did. The NavPane settings
         (the "Applications" subgrid shown on an Applicant's own form) belong to the
         REFERENCED entity's role (rev_applicant, type 1) — that is where a related-records
         subgrid configuration lives, not on the referencing side, which needs no subgrid of
         its own. -->
    <EntityRelationshipRoles>
      <EntityRelationshipRole>
        <NavPaneDisplayOption>UseCollectionName</NavPaneDisplayOption>
        <NavPaneArea>Details</NavPaneArea>
        <NavPaneOrder>10000</NavPaneOrder>
        <NavPaneLabel>
          <Descriptions>
            <Description description="Applications" languagecode="1033" />
          </Descriptions>
        </NavPaneLabel>
        <RelationshipRoleType>1</RelationshipRoleType>
      </EntityRelationshipRole>
      <EntityRelationshipRole>
        <RelationshipRoleType>0</RelationshipRoleType>
      </EntityRelationshipRole>
    </EntityRelationshipRoles>
  </EntityRelationship>
  <!-- WBS 0.4 remainder. Applicant (1) -> Bank Account (N), parental, cascade delete. TAD
       section 3.4 Gap 2: no source document states a retention period or a delete trigger
       for Bank Account, so it is parented to Applicant and removed by both the retention
       cascade and an erasure request, the same reasoning already applied to Review and Grant
       via Application. -->
  <EntityRelationship Name="rev_applicant_rev_bankaccount_applicantid">
    <EntityRelationshipType>OneToMany</EntityRelationshipType>
    <IsCustomizable>1</IsCustomizable>
    <IntroducedVersion>1.0.0.0</IntroducedVersion>
    <IsHierarchical>0</IsHierarchical>
    <ReferencingEntityName>rev_bankaccount</ReferencingEntityName>
    <ReferencedEntityName>rev_applicant</ReferencedEntityName>
    <ReferencingAttributeName>rev_applicantid</ReferencingAttributeName>
    <RelationshipDescription>
      <Descriptions>
        <Description description="The applicant this reimbursement account belongs to, blank for a provider-owned account. Parental: deleting the applicant deletes their bank account rows, which is the TAD section 3.4 Gap 2 DERIVED remediation - without it, Tier 4 bank details would survive both the retention cascade and an erasure request." languagecode="1033" />
      </Descriptions>
    </RelationshipDescription>
    <CascadeAssign>Cascade</CascadeAssign>
    <CascadeDelete>Cascade</CascadeDelete>
    <CascadeReparent>Cascade</CascadeReparent>
    <CascadeShare>Cascade</CascadeShare>
    <CascadeUnshare>Cascade</CascadeUnshare>
    <CascadeRollupView>NoCascade</CascadeRollupView>
    <IsValidForAdvancedFind>1</IsValidForAdvancedFind>
    <EntityRelationshipRoles>
      <EntityRelationshipRole>
        <NavPaneDisplayOption>UseCollectionName</NavPaneDisplayOption>
        <NavPaneArea>Details</NavPaneArea>
        <NavPaneOrder>10001</NavPaneOrder>
        <NavPaneLabel>
          <Descriptions>
            <Description description="Bank Accounts" languagecode="1033" />
          </Descriptions>
        </NavPaneLabel>
        <RelationshipRoleType>1</RelationshipRoleType>
      </EntityRelationshipRole>
      <EntityRelationshipRole>
        <RelationshipRoleType>0</RelationshipRoleType>
      </EntityRelationshipRole>
    </EntityRelationshipRoles>
  </EntityRelationship>
</EntityRelationships>
