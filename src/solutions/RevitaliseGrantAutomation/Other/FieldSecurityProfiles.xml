        <AttributeName>rev_otherconditionraw</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
