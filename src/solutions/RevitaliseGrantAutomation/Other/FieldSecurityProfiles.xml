        <EntityName>rev_application</EntityName>
        <AttributeName>rev_refereename</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Referee contact detail. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_refereeemail</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Referee contact detail. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_refereephone</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Identity of a third party captured with the application. Named in FR-051 as data an erasure request must reach. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_emergencycontactname</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Emergency contact detail. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_emergencycontactphone</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- CLOSES OPEN-3. The support recipient's own "Other" condition text. Special-category data about a THIRD PARTY who did not apply, so it gets exactly the treatment the applicant's rev_otherconditionraw gets - which is the point: sharing one column between two people made an erasure request for one of them impossible to honour (FR-051). -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_supportrecipientotherconditionraw</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Task 2 audit addition (2026-08-16). Special-category free text describing a third party's (the support recipient's) care needs, same treatment as rev_otherconditionraw. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_othercareprovidedtype</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Task 2 audit addition (2026-08-16). Worked example of care required - identifying detail about a third party, same treatment as rev_carersupport. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_careprovidedexample</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
