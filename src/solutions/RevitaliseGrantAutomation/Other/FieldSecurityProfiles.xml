        <EntityName>rev_application</EntityName>
        <AttributeName>rev_helperphone</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
