        <EntityName>rev_application</EntityName>
        <AttributeName>rev_receivesbenefits</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Which benefits, or who pays them. Naming a specific disability benefit reveals health information. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_benefitprovider</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
