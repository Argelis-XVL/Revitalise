        <EntityName>rev_application</EntityName>
        <AttributeName>rev_caresupportdescription</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
        <!-- Names of the other people travelling in the same group. Third-party identities captured with this application, and FR-051 requires an erasure request to be able to reach them. -->
        <EntityName>rev_application</EntityName>
        <AttributeName>rev_groupmembernames</AttributeName>
        <CanRead>4</CanRead>
        <CanUpdate>4</CanUpdate>
        <CanCreate>4</CanCreate>
        <CanReadUnmasked>0</CanReadUnmasked>
      </FieldPermission>
      <FieldPermission>
