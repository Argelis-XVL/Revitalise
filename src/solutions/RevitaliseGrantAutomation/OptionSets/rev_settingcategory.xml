<?xml version="1.0" encoding="utf-8"?>
<!-- Setting Category: the group a setting is listed under in the Settings list. Option values 1 to 8
     are assigned in the alphabetical order of the labels so that a sort by value and a sort by
     label give the same order (A-SETCAT-3). A later category takes the next value. The label text
     is the string the settings files carry in "category"; the seed script holds the same eight
     labels in its own table and a Pester test asserts they match. Created through the Dataverse
     Web API by ensure-schema.ps1, never by solution import (C-TECH-050, A-SETCAT-4). -->
<optionset Name="rev_settingcategory" localizedName="Setting Category">
  <OptionSetType>picklist</OptionSetType>
  <IsGlobal>1</IsGlobal>
  <IntroducedVersion>1.0.0.0</IntroducedVersion>
  <IsCustomizable>1</IsCustomizable>
  <options>
    <option value="1">
      <labels>
        <label description="Acceptance emails and reminders" languagecode="1033" />
      </labels>
    </option>
    <option value="2">
      <labels>
        <label description="Automatic rejection rules" languagecode="1033" />
      </labels>
    </option>
    <option value="3">
      <labels>
        <label description="Data retention and erasure" languagecode="1033" />
      </labels>
    </option>
    <option value="4">
      <labels>
        <label description="Lookup lists and wording" languagecode="1033" />
      </labels>
    </option>
    <option value="5">
      <labels>
        <label description="Narrative scrubbing" languagecode="1033" />
      </labels>
    </option>
    <option value="6">
      <labels>
        <label description="Postcodes and local authorities" languagecode="1033" />
      </labels>
    </option>
    <option value="7">
      <labels>
        <label description="Round statistics" languagecode="1033" />
      </labels>
    </option>
    <option value="8">
      <labels>
        <label description="Scoring and eligibility" languagecode="1033" />
      </labels>
    </option>
  </options>
  <Descriptions>
    <Description description="The group a setting belongs to, so the Settings list can be sorted, filtered and grouped by what the process owner is trying to do." languagecode="1033" />
  </Descriptions>
  <displaynames>
    <displayname description="Setting Category" languagecode="1033" />
  </displaynames>
</optionset>
