<?xml version="1.0" encoding="utf-8"?>
<!--
  rev_paymentstatus - the disbursement lifecycle (rev_payment.rev_paymentstatus). WBS 0.4
  remainder.

  SOURCED FROM v0.2's Payment build spec ("Payment status | Choice | Pending, Issued,
  Cleared, Cancelled. Finance."), NOT from the TAD. The TAD's own rev_payment column list
  (architecture section 3) omits this column entirely, but section 3.1's own framing rule -
  "Only attributes that drive a control, a requirement or a relationship are listed [...] the
  lists are non-exhaustive" - means the omission is not a decision to exclude it, and a
  payment lifecycle status is operationally necessary for the same reason rev_application
  and rev_grant each carry one: something has to say whether a given row is still pending,
  already issued, confirmed cleared, or cancelled before it was paid. Added on that basis, per
  the dispatch instruction accompanying this table.

  FOUR VALUES, NOT A PLACEHOLDER. v0.2 names all four explicitly - same footing as
  rev_payeetype.xml, unlike rev_paymentmethod.xml and rev_conditionareas.xml alongside it in
  this same change, which genuinely have no source-given values.

  DEFAULT VALUE IS Pending (1). A payment row is created before it is issued - the finance
  role captures the intent to pay before the disbursement itself happens (WBS 8.3's payment
  capture form) - so a freshly-created row with no status set yet should read as Pending, not
  as an ambiguous blank.

  SHAPE: <Descriptions>/<displaynames> AFTER </options>, no per-option <Descriptions>,
  matching the ground-truthed rev_grantstatus.xml pattern (IMP-0037).
-->
<optionset Name="rev_paymentstatus" localizedName="Payment Status">
  <OptionSetType>picklist</OptionSetType>
  <IsGlobal>1</IsGlobal>
  <IntroducedVersion>1.0.0.0</IntroducedVersion>
  <IsCustomizable>1</IsCustomizable>
  <options>
    <!-- 1 = Pending. The payment intent has been recorded but not yet issued. -->
    <option value="1">
      <labels>
        <label description="Pending" languagecode="1033" />
      </labels>
    </option>
    <!-- 2 = Issued. The disbursement has been sent (bank transfer, cheque, etc. per
         rev_method) but is not yet confirmed cleared. -->
    <option value="2">
      <labels>
        <label description="Issued" languagecode="1033" />
      </labels>
    </option>
    <!-- 3 = Cleared. Confirmed received by the payee / cleared in the charity's bank
         records. This is the state the duplicate-payment check and QuickBooks
         cross-reference (TAD section 4/ADR-017) treat as a real, completed payment. -->
    <option value="3">
      <labels>
        <label description="Cleared" languagecode="1033" />
      </labels>
    </option>
    <!-- 4 = Cancelled. Recorded but never actually disbursed - kept rather than deleted so
         the record of the decision survives. -->
    <option value="4">
      <labels>
        <label description="Cancelled" languagecode="1033" />
      </labels>
    </option>
  </options>
  <Descriptions>
    <Description description="The disbursement lifecycle for a payment row, from v0.2's Payment build spec (not restated in the TAD's own non-exhaustive column list - see this file's own header). Options are added over time but never renumbered or removed while rows reference them." languagecode="1033" />
  </Descriptions>
  <displaynames>
    <displayname description="Payment Status" languagecode="1033" />
  </displaynames>
</optionset>
