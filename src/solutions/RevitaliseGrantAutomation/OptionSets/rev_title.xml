<!--
  rev_title - PLACEHOLDER VALUES, TO CONFIRM.

  The raw export (docs/Import/Application Data Export(Sheet1).csv col 15, "Name (Title)")
  proves the live form collects a title, but the header row does not carry the option list and
  the single data row is empty, so the real values are NOT known from the export. The six
  options below are the set named in docs/Import/grant-application-data-model-v0.2.md
  ("Mr, Mrs, Ms, Mx, Dr, other") and are written here as a reasonable placeholder so the
  column can exist and be mapped.

  CONFIRM WITH EMILY BEFORE PRD. Renumbering or removing an option after applications exist
  changes what historic rows mean, so this is a pre-go-live confirmation, not a later tidy-up.
  Recorded in the Dev Summary as a "to confirm" option set alongside rev_applicanttype,
  rev_breaktype, rev_helperrelationship and rev_exceptionalcircumstance.
-->
<optionset Name="rev_title" localizedName="Title">
  <OptionSetType>picklist</OptionSetType>
  <IsGlobal>1</IsGlobal>
  <IntroducedVersion>1.0.0.0</IntroducedVersion>
  <IsCustomizable>1</IsCustomizable>
  <options>
    <option value="1">
      <labels>
        <label description="Mr" languagecode="1033" />
      </labels>
    </option>
    <option value="2">
      <labels>
        <label description="Mrs" languagecode="1033" />
      </labels>
    </option>
    <option value="3">
      <labels>
        <label description="Ms" languagecode="1033" />
      </labels>
    </option>
    <option value="4">
      <labels>
        <label description="Mx" languagecode="1033" />
      </labels>
    </option>
    <option value="5">
      <labels>
        <label description="Dr" languagecode="1033" />
      </labels>
    </option>
    <option value="6">
      <labels>
        <label description="Other" languagecode="1033" />
      </labels>
    </option>
    <option value="7">
      <labels>
        <label description="Prefer not to say" languagecode="1033" />
      </labels>
    </option>
  </options>
  <Descriptions>
    <Description description="How the applicant would like to be addressed. PLACEHOLDER VALUES - the real option list is not in the raw export and must be confirmed with the process owner before production use." languagecode="1033" />
  </Descriptions>
  <displaynames>
    <displayname description="Title" languagecode="1033" />
  </displaynames>
</optionset>
