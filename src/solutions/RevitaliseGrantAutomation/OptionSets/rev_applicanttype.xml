        <label description="An unpaid carer applying for myself" languagecode="1033" />
      </labels>
    </option>
    <option value="3">
      <labels>
        <label description="An unpaid carer applying with the person I care for" languagecode="1033" />
      </labels>
    </option>
    <option value="4">
      <labels>
        <label description="Someone applying on behalf of another person" languagecode="1033" />
      </labels>
    </option>
  </options>
  <Descriptions>
    <Description description="How the applicant describes themselves in relation to the break, from the form's 'Are you...' question. PLACEHOLDER VALUES - the real option list is not in the raw export and must be confirmed with the process owner before production use." languagecode="1033" />
