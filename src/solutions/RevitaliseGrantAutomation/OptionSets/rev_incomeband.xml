<?xml version="1.0" encoding="utf-8"?>
<optionset Name="rev_incomeband" localizedName="Income Band">
  <OptionSetType>picklist</OptionSetType>
  <IsGlobal>1</IsGlobal>
  <IntroducedVersion>1.0.0.0</IntroducedVersion>
  <IsCustomizable>1</IsCustomizable>
  <options>
    <!-- EF-29, 2026-09-17: replaced the placeholder five £10k-boundary bands plus "Prefer not
         to say" with the four bands Emily confirmed match the live form exactly
         (docs/Import/2026-09-16-emily-sheardown-artefact-delivery.md,
         docs/Import/2026-09-11-live-application-form-capture.md §2). "Prefer not to say" is
         dropped rather than kept as a fifth option: the live form never offered it, so no
         real application can hold it, and M-07's rule is that trimming an option set is safe
         only before any application exists (§6 "Everything here rests on evidence"). Safe now
         because DEV and Acceptance hold demo data only. -->
    <option value="1">
      <labels>
        <label description="Under £15,000" languagecode="1033" />
      </labels>
    </option>
    <option value="2">
      <labels>
        <label description="£15,000 to £24,999" languagecode="1033" />
      </labels>
    </option>
    <option value="3">
      <labels>
        <label description="£25,000 to £34,999" languagecode="1033" />
      </labels>
    </option>
    <option value="4">
      <labels>
        <label description="Over £35,000" languagecode="1033" />
      </labels>
    </option>
  </options>
  <Descriptions>
    <Description description="The household income band the applicant selected on the form. A band rather than an exact figure, because a band is all the eligibility decision needs (NFR-013, data minimisation). Four bands, EF-29 (2026-09-17): Under £15,000 / £15,000-£24,999 / £25,000-£34,999 / Over £35,000, matching the live form's own wording exactly." languagecode="1033" />
  </Descriptions>
  <displaynames>
    <displayname description="Income Band" languagecode="1033" />
  </displaynames>
</optionset>
