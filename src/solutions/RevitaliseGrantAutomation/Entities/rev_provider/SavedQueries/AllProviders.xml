<?xml version="1.0" encoding="utf-8"?>
<!--
  Default view — WBS 8.3. Shape copied from Entities/rev_roundfinance/SavedQueries/
  AllRoundFinances.xml (this solution's simplest existing saved query: one grid, one fetch,
  both listing the same columns in the same order). Unfiltered, isdefault="1" — opened by the
  plain Entity="rev_provider" SubArea (no Url) in AppModuleSiteMap.xml, the same pattern
  "All Grants"/"All Settings"/"All Round Finances" already use in this solution.
-->
<savedqueries>
  <savedquery>
    <savedqueryid>{f1000000-0000-4000-8000-00000000fe01}</savedqueryid>
    <name>All Providers</name>
    <description>Every holiday provider, active or retired.</description>
    <IsCustomizable>1</IsCustomizable>
    <isquickfindquery>0</isquickfindquery>
    <isdefault>1</isdefault>
    <querytype>0</querytype>
    <returnedtypecode>rev_provider</returnedtypecode>
    <layoutxml>
<grid name="resultset" object="0" jump="rev_name" select="1" icon="1" preview="1">
  <row name="result" id="rev_providerid">
        <cell name="rev_name" width="200" />
        <cell name="rev_contactemail" width="180" />
        <cell name="rev_region" width="120" />
        <cell name="rev_active" width="80" />
  </row>
</grid>
    </layoutxml>
    <fetchxml>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="rev_provider">
      <attribute name="rev_name" />
      <attribute name="rev_contactemail" />
      <attribute name="rev_region" />
      <attribute name="rev_active" />
    <order attribute="rev_name" descending="false" />
  </entity>
</fetch>
    </fetchxml>
  </savedquery>
</savedqueries>
