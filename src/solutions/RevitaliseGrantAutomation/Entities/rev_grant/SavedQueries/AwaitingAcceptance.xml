<?xml version="1.0" encoding="utf-8"?>
<!--
  Awaiting Acceptance - shape copied from Entities/rev_errorlog/SavedQueries/UnresolvedErrors.xml, which is
  live in REV-GrantApplications-DEV.

  A note on what the platform adds. The unmanaged export of this solution shows TEN SavedQueries
  on rev_errorlog where the repo commits one: Dataverse creates the system views (Active, Inactive,
  lookup, Advanced Find, associated) when the table is created. Those are platform-owned and are
  not committed here. Only views this project authors belong in source.
-->
<savedqueries>
  <savedquery>
    <savedqueryid>{e1000000-0000-4000-8000-0000000000a2}</savedqueryid>
    <name>Awaiting Acceptance</name>
    <description>Grants that have been awarded or issued but are not yet signed. This is the list the 14-day escalation (FR-044) will work from once WBS 3.3 is built.</description>
    <IsCustomizable>1</IsCustomizable>
    <isquickfindquery>0</isquickfindquery>
    <isdefault>0</isdefault>
    <querytype>0</querytype>
    <returnedtypecode>rev_grant</returnedtypecode>
    <layoutxml>
<grid name="resultset" object="0" jump="rev_name" select="1" icon="1" preview="1">
  <row name="result" id="rev_grantid">
        <cell name="rev_name" width="150" />
        <cell name="rev_applicationid" width="200" />
        <cell name="rev_status" width="150" />
        <cell name="rev_amountawarded" width="120" />
        <cell name="rev_holidaystart" width="120" />
        <cell name="rev_holidayend" width="120" />
        <cell name="rev_acceptanceissuedon" width="130" />
  </row>
</grid>
    </layoutxml>
    <fetchxml>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="rev_grant">
      <attribute name="rev_name" />
      <attribute name="rev_applicationid" />
      <attribute name="rev_status" />
      <attribute name="rev_amountawarded" />
      <attribute name="rev_holidaystart" />
      <attribute name="rev_holidayend" />
      <attribute name="rev_acceptanceissuedon" />
    <order attribute="rev_acceptanceissuedon" descending="true" />
    <filter type="and">
      <condition attribute="rev_status" operator="in">
        <value>1</value>
        <value>2</value>
      </condition>
    </filter>
  </entity>
</fetch>
    </fetchxml>
  </savedquery>
</savedqueries>
