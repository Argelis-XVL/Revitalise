<?xml version="1.0" encoding="utf-8"?>
<savedqueries>
  <!-- ADR-090: ordered by category, then display name, then key; Category first. A-SETCAT-3 (OPEN):
       whether the order on a choice column is by value or by label, and where an empty one sorts, is
       undocumented; values 1 to 8 follow the alphabetical label order so either answer gives the same order. -->
  <savedquery>
    <savedqueryid>{e5a7b9c1-6007-4a2b-8c11-0a1b2c3d4e57}</savedqueryid>
    <name>All Settings</name>
    <description>Every configuration setting read by the automated flows, grouped by category, with its current value and data type.</description>
    <IsCustomizable>1</IsCustomizable>
    <isquickfindquery>0</isquickfindquery>
    <isdefault>1</isdefault>
    <querytype>0</querytype>
    <returnedtypecode>rev_setting</returnedtypecode>
    <layoutxml>
<grid name="resultset" object="0" jump="rev_name" select="1" icon="1" preview="1">
  <row name="result" id="rev_settingid">
        <cell name="rev_category" width="200" />
        <cell name="rev_name" width="160" />
        <cell name="rev_displayname" width="180" />
        <cell name="rev_value" width="250" />
        <cell name="rev_datatype" width="130" />
        <cell name="rev_effectivefrom" width="130" />
  </row>
</grid>
    </layoutxml>
    <fetchxml>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="rev_setting">
      <attribute name="rev_category" />
      <attribute name="rev_name" />
      <attribute name="rev_displayname" />
      <attribute name="rev_value" />
      <attribute name="rev_datatype" />
      <attribute name="rev_effectivefrom" />
    <order attribute="rev_category" descending="false" />
    <order attribute="rev_displayname" descending="false" />
    <order attribute="rev_name" descending="false" />
  </entity>
</fetch>
    </fetchxml>
  </savedquery>
</savedqueries>
