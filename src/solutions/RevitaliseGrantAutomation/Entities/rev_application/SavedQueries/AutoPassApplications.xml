<?xml version="1.0" encoding="utf-8"?>
<!--
  EF-16, added 2026-09-19 to close a live gap the reviewer found (IMP-0784): this view did not
  exist at all, in source or in DEV, although WBS 6.2/6.4's Casework queues already carried
  Borderline, Auto-rejected and Under Review - Incomplete Scoring. rev_status = 2 is Auto-pass
  (see OptionSets/rev_applicationstatus.xml). Same layout/fetch shape as the three sibling
  queues (ActiveApplications.xml, BorderlineAwaitingReview.xml, AutoRejectedApplications.xml) -
  copy their column set exactly rather than inventing a new one, per this file's own established
  pattern. savedqueryid is hand-authored, continuing the e5a7b9c1-600x series already used by
  every other rev_application saved query in this folder. 6002-6006 are taken; 6007/6008 turned
  out to collide with existing rev_setting/rev_errorlog views elsewhere in this solution (caught
  by scripts/run-source-gates.py's guid-syntax check, IMP-0157) so this is 6009.
-->
<savedqueries>
  <savedquery>
    <savedqueryid>{e5a7b9c1-6009-4a2b-8c11-0a1b2c3d4e59}</savedqueryid>
    <name>Auto-pass Applications</name>
    <description>Applications the scoring process has marked Auto-pass. Grouped here so a caseworker can spot-check the free-text answers even though no decision is required.</description>
    <IsCustomizable>1</IsCustomizable>
    <isquickfindquery>0</isquickfindquery>
    <isdefault>0</isdefault>
    <querytype>0</querytype>
    <returnedtypecode>rev_application</returnedtypecode>
    <layoutxml>
<grid name="resultset" object="0" jump="rev_name" select="1" icon="1" preview="1">
  <row name="result" id="rev_applicationid">
        <cell name="rev_name" width="130" />
        <cell name="rev_applicantid" width="200" />
        <cell name="rev_status" width="150" />
        <cell name="rev_submittedon" width="150" />
        <cell name="rev_circumstancescore" width="110" />
  </row>
</grid>
    </layoutxml>
    <fetchxml>
<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="rev_application">
      <attribute name="rev_name" />
      <attribute name="rev_applicantid" />
      <attribute name="rev_status" />
      <attribute name="rev_submittedon" />
      <attribute name="rev_circumstancescore" />
    <order attribute="rev_submittedon" descending="true" />
    <filter type="and">
      <condition attribute="rev_status" operator="eq" value="2" />
    </filter>
  </entity>
</fetch>
    </fetchxml>
  </savedquery>
</savedqueries>
