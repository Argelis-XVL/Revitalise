{
  "name": "rev-trustee-review-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "REV Trustee Review Portal — Power Apps Code App (WBS 6.1-6.5, FR-034..FR-039)",
  "scripts": {
    "dev": "concurrently -k -n pac,vite -c blue,green \"pac code run\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "push": "pac code push"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@microsoft/power-apps": "1.3.0",
    "@tanstack/react-query": "5.101.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "10.0.5",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
