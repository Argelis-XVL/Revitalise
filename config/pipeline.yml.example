# Pipeline Configuration
# Generated by: development-agent  (reviewed before first deployment)
# Consumed by:  pipeline-agent
#
# Copy this file to config/<feature-slug>-pipeline.yml and fill in all values.
# Replace every <placeholder> before use.

feature: <feature-slug>
artifact: build/artifacts/<feature-slug>-<YYYYMMDD>-<build-number>/

# Rollback artifact — previous stable version.
# Update this after each successful Prd deployment.
rollback_artifact: build/artifacts/<feature-slug>-<previous>/

# ── Tenant-level prerequisites ────────────────────────────────────────────────
# Objects that live OUTSIDE any environment (Entra ID, SPO site collections,
# Teams org app catalog). Executed ONCE by pipeline-agent as Stage 0, behind the
# APPROVE TENANT gate, before any environment deployment. Scripts must be
# idempotent (C-TECH-042) — re-runs report EXISTS, not errors.
# Omit this block entirely if the feature has no tenant-level dependencies.
tenant_prerequisites:
  gate: APPROVE TENANT
  operations:
    - description: App registration <name> exists with least-privilege API permissions
      script: provisioning/entra/ensure-app-registration.ps1
    - description: Admin consent granted for <permissions>
      script: provisioning/entra/grant-admin-consent.ps1
    - description: Entra security groups exist per persona per environment
      script: provisioning/entra/ensure-groups.ps1
    - description: Teams app published to org catalog
      script: provisioning/teams/publish-teams-app.ps1

environments:

  test:
    auto_deploy: true          # deployed automatically after test-agent approval
    deploy_command: >
      <your deploy tool> deploy
        --artifact {artifact}
        --environment {env_url}
        --mode managed
    env_url: <TEST_ENV_URL or $ENV_VAR>
    # Post-deployment configuration — everything the feature needs in THIS
    # environment that is not a solution component. Executed in order after
    # deploy_command, before smoke_tests. All scripts idempotent (C-TECH-042);
    # environment-specific values from deploymentSettings/<env>-settings.json.
    # Remove steps that don't apply; omit the block if there are none.
    post_deploy:
      - description: Create/verify group teams and bind security roles to Entra groups
        script: provisioning/dataverse/bind-roles-to-groups.ps1 -Env test
      - description: Provision SharePoint site + document locations
        script: provisioning/sharepoint/ensure-site.ps1 -Env test
      - description: Install/update Teams app in target team
        script: provisioning/teams/install-teams-app.ps1 -Env test
      - description: Share Code/Canvas apps with persona security groups
        script: provisioning/dataverse/share-apps.ps1 -Env test
    smoke_tests:
      - description: Solution / app version matches artifact
        command: <verification command or manual step>
      - description: Core health check endpoint returns 200
        command: <e.g. "curl -f https://test.example.com/health">
      - description: Group team exists and holds the TAD §6.1 roles
        command: <e.g. "pwsh provisioning/dataverse/verify-role-bindings.ps1 -Env test">
    rollback_command: >
      <your deploy tool> deploy
        --artifact {rollback_artifact}
        --environment {env_url}

  acc:
    gate: APPROVE ACC           # pipeline-agent waits for this keyword
    deploy_command: >
      <your deploy tool> deploy
        --artifact {artifact}
        --environment {env_url}
        --mode managed
    env_url: <ACC_ENV_URL or $ENV_VAR>
    post_deploy:
      - description: Create/verify group teams and bind security roles to Entra groups
        script: provisioning/dataverse/bind-roles-to-groups.ps1 -Env acc
      # ...repeat the applicable steps from the test block with -Env acc
    smoke_tests:
      - description: Solution / app version matches artifact
        command: <verification command>
      - description: Run acceptance smoke suite
        command: <e.g. "npx playwright test --project=smoke">
    rollback_command: >
      <your deploy tool> deploy
        --artifact {rollback_artifact}
        --environment {env_url}

  prd:
    gate: APPROVE PRD           # pipeline-agent waits for this keyword
    deploy_command: >
      <your deploy tool> deploy
        --artifact {artifact}
        --environment {env_url}
        --mode managed
    env_url: <PRD_ENV_URL or $ENV_VAR>
    post_deploy:
      - description: Create/verify group teams and bind security roles to Entra groups
        script: provisioning/dataverse/bind-roles-to-groups.ps1 -Env prd
      # ...repeat the applicable steps from the test block with -Env prd
    smoke_tests:
      - description: Solution / app version matches artifact
        command: <verification command>
      - description: Error rate baseline check (< 1%)
        command: <e.g. query monitoring dashboard or alert API>
    rollback_command: >
      <your deploy tool> deploy
        --artifact {rollback_artifact}
        --environment {env_url}
    rollback_requires_human: true   # never auto-rollback in production

# Notification settings (optional)
notifications:
  on_success: <slack channel or email>
  on_failure: <slack channel or email>
  on_rollback: <slack channel or email>

# Escalation contacts
escalation:
  deployment_failure: <name and contact>
  data_issue: <name and contact>
  security_incident: <name and contact>
