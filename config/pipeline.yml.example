# Pipeline Configuration — TEMPLATE
# Generated by: development-agent  (reviewed before first deployment)
# Consumed by:  pipeline-agent, .github/workflows/ci.yml
#
# Copy this file to config/<feature-slug>-pipeline.yml and fill in all values.
# Replace every <placeholder> before use.
#
# ═════════════════════════════════════════════════════════════════════════════
# ⚠ THIS TEMPLATE WAS REWRITTEN 2026-08-12 AND IS NOW THE PROJECT'S DEFAULT SHAPE
#
# Two project-wide decisions are baked in. Both were reviewer decisions on the
# revitalise-grant-automation feature, and both are recorded here because
# .github/workflows/ci.yml is SHARED — a config generated from the old template
# would now fail, because ci.yml no longer reads `deploy_command` and requires
# `alm.stage_dev_command` and `promote_mode`. This is a correctness change, not a
# stylistic preference.
#
#   1. THREE ENVIRONMENTS: DEV → TST/ACC → PRD  (TAD ADR-006, `Adopted`)
#      Test and Acceptance are ONE combined environment. There are TWO deploy
#      targets, `tst_acc` and `prd`. The four-environment default in
#      agents/WORKFLOW.md, and its `APPROVE ACC` gate, DO NOT APPLY: there is no
#      Acc hop to gate. `APPROVE PRD` is the single human deployment gate below
#      Stage 0. If a future feature genuinely needs a separate Acc environment,
#      that is a new ADR, not a silent edit to this file.
#
#   2. POWER PLATFORM PIPELINES IS THE PROMOTION MECHANISM  (TAD ADR-007, `Adopted`)
#      GitHub Actions validates, builds, and imports the UNMANAGED solution into
#      DEV. Power Platform Pipelines then exports from DEV itself and promotes
#      DEV → TST/ACC → PRD. GitHub Actions NEVER imports into TST/ACC or PRD, and
#      cannot hand Pipelines a pre-built artefact.
#      Read config/revitalise-grant-automation-pipeline.yml → `alm` for the full
#      reasoning, the Microsoft Learn citations, and the list of behaviours that
#      change relative to `pac solution import` (no settings file, no
#      --force-overwrite, platform-enforced stage order, different rollback).
# ═════════════════════════════════════════════════════════════════════════════

feature: <feature-slug>

# ⚠ NOT the deployed artefact. Under Power Platform Pipelines the deployed bits
# are exported from DEV by the platform and stored immutably in the pipelines
# host. This directory is the build-validation and audit artefact — solution
# checker output, packed zips proving the source packs cleanly, and the
# provisioning snapshot. The UNMANAGED zip in it IS deployed, but only into DEV,
# as the hand-off to Pipelines.
artifact: build/artifacts/<feature-slug>-<YYYYMMDD>-<build-number>/

# Previous stable version, for the rollback route. Under Pipelines the
# first-choice rollback is redeploying a previous version from the pipeline's run
# history, so this is a fallback record rather than the mechanism.
# Update after each successful Prd deployment (C-TECH-033).
rollback_artifact: build/artifacts/<feature-slug>-<previous>/

# ── ALM: how a solution moves between environments ────────────────────────────
alm:
  tool: power-platform-pipelines
  solution_unique_name: <SolutionUniqueName>
  pipeline_name: "<pipeline name as created in the pipelines host>"

  # THE HAND-OFF POINT. Makes DEV's unmanaged solution match this repository, so
  # that what Pipelines exports is what is under source control.
  # `--publish-changes` is REQUIRED: Pipelines does not publish unmanaged
  # customisations before exporting, so unpublished changes would be silently
  # missing from the artefact.
  # ⚠ Overwrites unmanaged customisations in DEV. A maker who edits in the maker
  #   portal without committing loses that work here.
  stage_dev_command: >
    pac solution import
      --path {artifact}/<SolutionUniqueName>.zip
      --environment {dev_env_url}
      --async --max-async-wait-time 60
      --force-overwrite --publish-changes --activate-plugins

environments:

  # ── TST/ACC — combined Test and Acceptance ──────────────────────────────────
  tst_acc:
    auto_deploy: true          # no APPROVE ACC gate exists for this topology
    # No `gate:` key by design. Acceptance sign-off happens inside this stage
    # alongside the test-agent gate. The next human gate is APPROVE PRD.

    # `manual` — CI stages DEV and stops; a human promotes in the Pipelines UI.
    #            The job's GitHub Environment approval gate IS the wait, and the
    #            version check refuses to run post_deploy against an environment
    #            that was never promoted. Put required reviewers on `tst_acc`.
    # `cli`    — the job runs `pac pipeline deploy` itself. Needs
    #            PIPELINE_STAGE_ID on the GitHub Environment. No reviewers needed.
    # Start at `manual` for a feature's first release: it is the only mode whose
    # behaviour can be observed before it is trusted.
    promote_mode: manual
    pipeline_stage_name: "<stage name, e.g. Deploy to TST/ACC>"
    # Stage GUIDs are per-tenant and are never committed. Read them with
    # `pac pipeline list --pipeline "<pipeline name>"` and store as the
    # PIPELINE_STAGE_ID secret on the matching GitHub Environment.
    pipeline_stage_id: $PIPELINE_STAGE_ID
    current_version: <e.g. 1.0.0.0>   # only used when promote_mode is `cli`
    new_version: <e.g. 1.0.0.1>
    env_url: $ENV_URL_TEST     # ENV_URL_TEST is the combined TST/ACC environment

    # ── Environment prerequisites — BEFORE THE FIRST DEPLOY INTO THIS ENV ─────
    # Everything the deploy mechanism cannot CREATE, only update (TAD §12.1,
    # C-TECH-050). On Dataverse: Entities/Attributes, Global OptionSets, Security
    # Roles, Field Security Profiles — Microsoft documents these as unsupported to
    # create from scratch via solution import. Create them via the Web API first,
    # then import can manage them.
    #
    # ⚠ PER ENVIRONMENT, NOT PER FEATURE. DEV being prepared says nothing about
    #   this one. Missing this is what turned a "just import it" task into a
    #   fifteen-attempt investigation on the feature that added this block.
    #   Omit the block only if the deploy genuinely creates everything.
    #
    # Idempotent (C-TECH-042): a clean re-run reports EXISTS for everything it
    # already made, and anything else needs investigating BEFORE the import.
    environment_prerequisites:
      - description: Create the schema this environment's first import cannot create
        script: provisioning/dataverse/ensure-schema.ps1 -Env test
      # Components created above get PLATFORM-ASSIGNED ids. Source that declares
      # its own is either rejected outright or silently ignored (C-TECH-051).
      # Read the live values back and reconcile before importing — or, better,
      # reference those components by name/schemaName so there is nothing to sync.
      - description: Reconcile platform-assigned ids into source (roles, profiles, sitemaps)
        script: <script, or `manual` with the exact queries in its description>

    # Guards that must hold BEFORE promotion. `script: manual` is recorded as an
    # operator checklist item in the job summary, not executed (and not skipped).
    pre_deploy:
      - description: Confirm this environment holds synthetic or anonymised data only (C-TECH-007)
        script: manual

    # Everything the feature needs in THIS environment that is not a solution
    # component. Executed in order after promotion, before smoke_tests. All
    # scripts idempotent (C-TECH-042); per-environment values from
    # deploymentSettings/<env>-settings.json. Omit the block if there are none.
    post_deploy:
      - description: Create/verify group teams and bind security roles to Entra groups
        script: provisioning/dataverse/bind-roles-to-groups.ps1 -Env test
      - description: Provision SharePoint site + document locations
        script: provisioning/sharepoint/ensure-site.ps1 -Env test
      - description: Share Code/Canvas apps with persona security groups
        script: provisioning/dataverse/share-apps.ps1 -Env test
      - description: >
          MANUAL — bind connection references to service-account connections
          (interactive OAuth consent, so not scriptable)
        script: manual

    smoke_tests:
      - description: Solution version matches the promoted version
        command: <e.g. "pac solution list --environment $ENV_URL_TEST | grep -E '<Name>[[:space:]]+1\.0\.0\.0'">
      - description: Group team exists and holds the TAD §6.1 roles
        command: <e.g. "pwsh provisioning/dataverse/verify-role-bindings.ps1 -Env test">
      - description: An end-to-end case owned by the test-agent
        command: manual step — test-agent

    # ── Verification before this environment is called deployed (C-TECH-053) ──
    # A zero exit code is the deploy tool's opinion about its own run. Three
    # separate things, because passing one does not imply the others:
    #   (a) the components exist — QUERY them, don't infer from the deploy result
    #   (b) it is idempotent — re-run the deploy, expect clean success
    #   (c) A HUMAN CAN USE IT — open every flow/app in the designer and SAVE it
    #
    # ⚠ (c) IS NOT OPTIONAL AND CANNOT BE AUTOMATED AWAY. Three of the fifteen
    #   failures on this project were invisible to (a) and (b): the import
    #   succeeded, the flow existed and was queryable, and no maker could open or
    #   save it. Until (c) is done the environment is DEPLOYED (V3), not VERIFIED.
    verification:
      - description: (a) Every component exists in the target — queried by name, not inferred
        command: <e.g. "pwsh provisioning/dataverse/verify-components.ps1 -Env test">
      - description: (b) Idempotency — the deploy re-run succeeds cleanly against the deployed target
        command: <re-run of the deploy/promote command>
      - description: >
          (c) V4 — a named person opens every flow, app and editable component in the
          designer and SAVES it. Record who, when, and any component that would not save.
        script: manual
        owner: <name — this step has an owner, not just a checkbox>

    # Never executed by CI. Under Pipelines this is a UI operation.
    rollback_command: >
      MANUAL — Power Platform Pipelines: Pipelines page → Run history → the last
      known-good deployment to this stage → redeploy that solution version.
      Requires the pipeline's redeploy-previous-versions setting to be enabled.

  # ── PRD ─────────────────────────────────────────────────────────────────────
  prd:
    gate: APPROVE PRD          # the single remaining human deployment gate
    # Pipelines independently enforces stage order, so PRD cannot receive a
    # version TST/ACC has not already taken.
    promote_mode: manual
    pipeline_stage_name: "<stage name, e.g. Deploy to PRD>"
    pipeline_stage_id: $PIPELINE_STAGE_ID
    current_version: <e.g. 1.0.0.0>
    new_version: <e.g. 1.0.0.1>
    env_url: $ENV_URL_PRD

    # ⚠ RUNS AGAIN HERE. This block is per-environment state (C-TECH-050). PRD has
    #   never been imported into, so it needs exactly what DEV and TST/ACC needed,
    #   and it will assign its OWN ids to what the scripts create (C-TECH-051).
    #   "It worked in TST/ACC" is not evidence about this environment.
    environment_prerequisites:
      - description: Create the schema this environment's first import cannot create
        script: provisioning/dataverse/ensure-schema.ps1 -Env prd
      - description: Reconcile platform-assigned ids into source (roles, profiles, sitemaps)
        script: <script, or `manual` with the exact queries in its description>

    pre_deploy:
      - description: Confirm outstanding compliance / sign-off decisions are recorded
        script: manual

    post_deploy:
      - description: Create/verify group teams and bind security roles to Entra groups
        script: provisioning/dataverse/bind-roles-to-groups.ps1 -Env prd
      # ...repeat the applicable steps from the tst_acc block with -Env prd

    smoke_tests:
      - description: Solution version matches the promoted version
        command: <verification command>
      - description: Error rate baseline check
        command: <e.g. query the unresolved-errors view>

    # Same three checks as tst_acc (C-TECH-053) — and note that a MANAGED import is
    # a different code path from the unmanaged one proven in DEV, with its own
    # failure modes. Proven unmanaged is not proven managed.
    verification:
      - description: (a) Every component exists in the target — queried by name
        command: <verification command>
      - description: (b) Idempotency — the deploy re-run succeeds cleanly
        command: <re-run of the deploy/promote command>
      - description: (c) V4 — a named person opens and saves every flow/app in the designer
        script: manual
        owner: <name>

    rollback_command: >
      MANUAL — Power Platform Pipelines: Run history → last known-good deployment
      to this stage → redeploy that version. ⚠ For a FIRST managed release there
      is no previous version, and uninstalling a first managed solution removes
      its tables and their data — the route is then: disable the flows, leave the
      solution in place, fix forward.
    rollback_requires_human: true   # never auto-rollback in production

# ── Tenant-level prerequisites ────────────────────────────────────────────────
# Objects that live OUTSIDE any environment (Entra ID, SPO site collections,
# Teams org app catalog, and the PIPELINES HOST). Executed ONCE by pipeline-agent
# as Stage 0, behind the APPROVE TENANT gate, before any environment deployment.
# Scripts must be idempotent (C-TECH-042) — re-runs report EXISTS, not errors.
# Omit this block entirely if the feature has no tenant-level dependencies.
tenant_prerequisites:
  gate: APPROVE TENANT
  operations:
    # ── Required by the Power Platform Pipelines ALM choice (ADR-007) ─────────
    - description: >
        MANUAL — PIPELINES HOST ENVIRONMENT. A dedicated Dataverse environment holding all
        pipeline configuration, security and run history. Must be a CUSTOM host, not the
        auto-provisioned "platform host": platform-host pipelines are personal pipelines,
        "can't be extended", can't be shared, and cap at three environments. Create via
        PPAC → Deployments → New custom host, or install the "Power Platform Pipelines"
        application into an existing environment via Environments → <host> → Resources →
        Dynamics 365 apps. ⚠ Deleting the host deletes all pipelines and run history.
        https://learn.microsoft.com/en-us/power-platform/alm/custom-host-pipelines
      script: manual
    - description: >
        MANUAL — PIPELINE AND STAGES in the Deployment Pipeline Configuration app: one
        Environment record per environment (DEV typed Development, others typed Target),
        each validating to Success; then the pipeline with its stages IN ORDER, each stage's
        Previous Deployment Stage set. Read the stage GUIDs with `pac pipeline list` and
        store them as PIPELINE_STAGE_ID on the matching GitHub Environments. Enable the
        redeploy-previous-versions setting or rollback by redeployment is unavailable.
      script: manual
    - description: >
        MANUAL — ALL TARGET ENVIRONMENTS MUST BE MANAGED ENVIRONMENTS, which requires
        licences granting premium use rights. The host and development environments do not.
        This is a LICENCE COST consequence of the ALM choice — confirm the entitlement
        position before provisioning.
        https://learn.microsoft.com/en-us/power-platform/alm/pipelines
      script: manual
    - description: >
        MANUAL — PIPELINES ACCESS: "Deployment Pipeline Administrator" in the host for
        whoever administers pipelines; the pipeline record shared with whoever runs it.
        ⚠ Whether a SERVICE PRINCIPAL may *request* a promotion is not documented — this is
        the item to settle before moving any `promote_mode` from `manual` to `cli`.
      script: manual
    # ── Feature-specific ─────────────────────────────────────────────────────
    - description: >
        App registrations. ONE DEPLOY REGISTRATION PER TARGET ENVIRONMENT, each with
        EXACTLY ONE federated credential scoped to its own GitHub Environment subject
        (`repo:<org>/<repo>:environment:<env>`), and each an application user in ITS OWN
        environment only. Not several credentials on one shared registration: that gates
        token ISSUANCE but not AUTHORITY, because every subject resolves to one service
        principal that is an application user everywhere (C-TECH-043, ADR-007).
      script: provisioning/entra/ensure-app-registration.ps1
    - description: Admin consent granted for <permissions>
      script: provisioning/entra/grant-admin-consent.ps1
    - description: Entra security groups exist per persona per environment
      script: provisioning/entra/ensure-groups.ps1
    - description: Teams app published to org catalog
      script: provisioning/teams/publish-teams-app.ps1

# Notification settings (optional)
notifications:
  on_success: <slack channel or email>
  on_failure: <slack channel or email>
  on_rollback: <slack channel or email>

# Escalation contacts
escalation:
  deployment_failure: <name and contact>
  data_issue: <name and contact>
  security_incident: <name and contact>
