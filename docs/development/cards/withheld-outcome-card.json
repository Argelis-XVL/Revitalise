{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "Application needs review",
      "wrap": true,
      "weight": "Bolder",
      "size": "Medium",
      "color": "Warning"
    },
    {
      "type": "TextBlock",
      "text": "A scored answer was missing, so no outcome was calculated.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "separator": true,
      "facts": [
        {
          "title": "Reference",
          "value": "@{triggerOutputs()?['body/rev_name']}"
        },
        {
          "title": "Status",
          "value": "Under Review"
        },
        {
          "title": "Circumstance score",
          "value": "Not calculated"
        },
        {
          "title": "Wellbeing answers missing",
          "value": "@{if(greater(length(body('Find_missing_wellbeing_answers')), 0), join(body('List_the_missing_question_numbers'), ', '), 'none')}"
        },
        {
          "title": "Life-satisfaction answer",
          "value": "@{if(empty(coalesce(string(outputs('Parse_feeling_scale_inversion')?[string(triggerOutputs()?['body/rev_feelingscaleanswer'])]), '')), 'missing, or not a value the scoring configuration recognises', 'supplied')}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Complete the missing answers with the applicant, then set the status by hand and record your override reason. There is no automated re-score for this application.",
      "wrap": true,
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "No score has been written, and none should be inferred.@{if(empty(parameters('rev_GrantAdminAppUrl')), ' The buttons below need the Grant Administration App URL environment variable set for this environment.', '')}",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Reference and question numbers only - no name, condition or narrative is included in this message by design.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open this application",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entityrecord&etn=rev_application&id=@{triggerOutputs()?['body/rev_applicationid']}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open the Under Review queue",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entitylist&etn=rev_application&viewid=e5a7b9c1-6004-4a2b-8c11-0a1b2c3d4e54"
    }
  ]
}
