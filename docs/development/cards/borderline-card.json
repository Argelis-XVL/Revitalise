{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "Borderline application",
      "wrap": true,
      "weight": "Bolder",
      "size": "Medium",
      "color": "Warning"
    },
    {
      "type": "TextBlock",
      "text": "Needs your judgement before it can progress.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "separator": true,
      "facts": [
        {
          "title": "Reference",
          "value": "@{triggerOutputs()?['body/rev_name']}"
        },
        {
          "title": "Circumstance score",
          "value": "@{outputs('Round_the_circumstance_score')} of @{first(body('Setting_MaxCircumstanceScore'))?['rev_value']}"
        },
        {
          "title": "Borderline band",
          "value": "@{first(body('Setting_BorderlineBandLower'))?['rev_value']} to @{first(body('Setting_BorderlineBandUpper'))?['rev_value']}"
        },
        {
          "title": "Income",
          "value": "@{if(equals(outputs('Derive_income_flag'), 1), 'Within the ceiling', if(equals(outputs('Derive_income_flag'), 2), 'Above the ceiling', 'Not stated'))}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "This application will not progress until you review it.",
      "wrap": true,
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "TextBlock",
      "text": "If you disagree with the score, change the status and record your reason - the override is kept against your name.@{if(empty(parameters('rev_GrantAdminAppUrl')), ' The buttons below need the Grant Administration App URL environment variable set for this environment.', '')}",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Reference, score and income flag only - no name, condition or narrative is included in this message by design.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open this application",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entityrecord&etn=rev_application&id=@{triggerOutputs()?['body/rev_applicationid']}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open the Borderline queue",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entitylist&etn=rev_application&viewid=e5a7b9c1-6003-4a2b-8c11-0a1b2c3d4e53"
    }
  ]
}
