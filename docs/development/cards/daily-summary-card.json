{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "Grant applications - daily summary",
      "wrap": true,
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Since @{formatDateTime(outputs('Compute_reporting_window_start'), 'dd MMM yyyy HH:mm')} UTC:",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "•  Scored: @{length(body('Count_applications_scored_in_the_window')?['value'])}",
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "•  Auto-rejected: @{length(body('Count_auto_rejected_in_the_window')?['value'])}",
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "Waiting for you now:",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "•  Borderline awaiting review: @{length(body('Count_borderline_awaiting_review')?['value'])}",
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "•  Under review, no score calculated: @{length(body('Count_withheld_awaiting_review')?['value'])}",
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "Counts only - no applicant details are included in this message by design.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Borderline awaiting review",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entitylist&etn=rev_application&viewid=e5a7b9c1-6003-4a2b-8c11-0a1b2c3d4e53"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Under review, no score",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entitylist&etn=rev_application&viewid=e5a7b9c1-6004-4a2b-8c11-0a1b2c3d4e54"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Auto-rejected",
      "url": "@{parameters('rev_GrantAdminAppUrl')}&pagetype=entitylist&etn=rev_application&viewid=e5a7b9c1-6005-4a2b-8c11-0a1b2c3d4e55"
    }
  ]
}
